<% if controller.controller_name == 'roles' && %w[new edit create update].include?(controller.action_name) %>
<%= javascript_tag nonce: true do %>
(function() {
  var view = document.querySelector('input[type="checkbox"][value="view_tag_clouds"]');
  var select = document.querySelector('input[type="checkbox"][value="select_tag_clouds"]');
  var manage = document.querySelector('input[type="checkbox"][value="manage_tag_clouds"]');
  var editTags = document.querySelector('input[type="checkbox"][value="edit_issue_tags"]');
  var createTags = document.querySelector('input[type="checkbox"][value="create_issue_tags"]');

  function syncClouds() {
    if (!view || !select || !manage) return;
    if (manage.checked) {
      select.checked = true;
      view.checked = true;
      select.disabled = true;
      view.disabled = true;
    } else if (select.checked) {
      view.checked = true;
      select.disabled = false;
      view.disabled = true;
    } else {
      select.disabled = false;
      view.disabled = false;
    }
  }

  function syncIssueTags() {
    if (!editTags || !createTags) return;
    if (editTags.checked) {
      createTags.disabled = false;
    } else {
      createTags.checked = false;
      createTags.disabled = true;
    }
  }

  function sync() {
    syncClouds();
    syncIssueTags();
  }

  if (manage) manage.addEventListener('change', sync);
  if (select) select.addEventListener('change', sync);
  if (editTags) editTags.addEventListener('change', sync);
  sync();

  var form = (manage && manage.form) || (editTags && editTags.form);
  if (!form) return;
  form.addEventListener('submit', function() {
    if (manage && manage.checked) {
      select.disabled = false;
      view.disabled = false;
      select.checked = true;
      view.checked = true;
    } else if (select && select.checked) {
      view.disabled = false;
      view.checked = true;
    }
    if (editTags && createTags) {
      if (!editTags.checked) {
        createTags.checked = false;
      }
      createTags.disabled = false;
    }
  });
})();
<% end %>
<% end %>
