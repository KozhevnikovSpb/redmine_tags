<% if controller.controller_name == 'roles' && %w[new edit create update].include?(controller.action_name) %>
<%= javascript_tag nonce: true do %>
(function() {
  var view = document.querySelector('input[type="checkbox"][value="view_tag_clouds"]');
  var select = document.querySelector('input[type="checkbox"][value="select_tag_clouds"]');
  var manage = document.querySelector('input[type="checkbox"][value="manage_tag_clouds"]');
  if (!view || !select || !manage) return;

  function sync() {
    if (manage.checked) {
      select.checked = true;
      view.checked = true;
      select.disabled = true;
      view.disabled = true;
    } else if (select.checked) {
      view.checked = true;
      select.disabled = false;
      view.disabled = true;
    } else {
      select.disabled = false;
      view.disabled = false;
    }
  }

  manage.addEventListener('change', sync);
  select.addEventListener('change', sync);
  sync();

  var form = manage.form;
  if (!form) return;
  form.addEventListener('submit', function() {
    if (manage.checked) {
      select.disabled = false;
      view.disabled = false;
      select.checked = true;
      view.checked = true;
    } else if (select.checked) {
      view.disabled = false;
      view.checked = true;
    }
  });
})();
<% end %>
<% end %>
