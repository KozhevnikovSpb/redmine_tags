$('#ajax-modal').html('<%= escape_javascript(render partial: 'tag_cloud_preferences/select_modal') %>');
showModal('ajax-modal', '560px');
$('#ajax-modal').css({ height: 'auto', 'max-height': 'none', 'min-height': '0' });
$('#ajax-modal').closest('.ui-dialog').css({ height: 'auto', width: '560px' });

(function () {
  function initGroupSortable(selector) {
    var $list = $(selector);
    if (!$list.length || typeof $.fn.sortable !== 'function') {
      return;
    }

    function syncOrderInputs() {
      $list.find('.tag-cloud-row').each(function () {
        var id = $(this).data('id');
        $(this).find('input.tag-cloud-order-input').val(id);
      });
    }

    $list.sortable({
      handle: '.tag-cloud-drag-handle',
      axis: 'y',
      containment: $list,
      tolerance: 'pointer',
      placeholder: 'tag-cloud-row-placeholder',
      helper: 'clone',
      opacity: 0.9,
      update: function () {
        syncOrderInputs();
      }
    });

    syncOrderInputs();
  }

  initGroupSortable('#tag-clouds-sortable-inherited');
  initGroupSortable('#tag-clouds-sortable');
})();
