<h3 class="title"><%= l(:label_select_visible_tag_clouds) %></h3>

<%= form_tag(project_tag_cloud_preferences_path(@project), method: :put, id: 'select-visible-tag-clouds-form') do %>
  <fieldset class="box tabular">
    <legend><%= l(:label_tag_clouds_visibility) %></legend>

    <% if @tag_clouds.blank? %>
      <p class="nodata"><%= l(:label_no_data) %></p>
    <% else %>
      <div class="tag-clouds-visibility-list">
        <% @tag_clouds.each do |cloud| %>
          <label class="floating" for="visible_tag_cloud_<%= cloud.id %>">
            <%= check_box_tag 'visible_tag_cloud_ids[]',
                              cloud.id,
                              @visible_ids.include?(cloud.id),
                              id: "visible_tag_cloud_#{cloud.id}" %>
            <span class="tag-cloud-name"><%= cloud.name %></span>
          </label>
        <% end %>
      </div>

      <p class="info tag-clouds-visibility-hint">
        <%= l(:text_select_visible_tag_clouds_hint) %>
      </p>
    <% end %>
  </fieldset>

  <div class="buttons tag-clouds-visibility-buttons">
    <%= submit_tag l(:button_save), name: nil, disabled: @tag_clouds.blank? %>
    <%= submit_tag l(:button_cancel), name: nil, onclick: 'hideModal(this);', type: 'button' %>
  </div>
<% end %>
