<h3 class="title"><%= l(:label_select_visible_tag_clouds) %></h3>

<%= form_tag(project_tag_cloud_preferences_path(@project), method: :put, id: 'select-visible-tag-clouds-form') do %>
  <div class="box tag-clouds-visibility-box">
    <% if @tag_clouds.blank? %>
      <p class="nodata"><%= l(:label_no_data) %></p>
    <% else %>
      <ul class="tag-clouds-visibility-list" id="tag-clouds-sortable">
        <% @tag_clouds.each do |cloud| %>
          <% count = (@issue_counts || {})[cloud.id].to_i %>
          <li class="tag-cloud-row" data-id="<%= cloud.id %>">
            <label for="visible_tag_cloud_<%= cloud.id %>">
              <%= check_box_tag 'visible_tag_cloud_ids[]',
                                cloud.id,
                                @visible_ids.include?(cloud.id),
                                id: "visible_tag_cloud_#{cloud.id}" %>
              <span class="tag-cloud-name"><%= cloud.name %></span>
            </label>
            <span class="tag-cloud-issue-count"
                  title="<%= l(:label_issue_plural) %>"><%= count %></span>
            <span class="sort-handle tag-cloud-drag-handle" title="<%= l(:label_tag_cloud_drag_to_reorder) %>">
              <%= sprite_icon('reorder', '') %>
            </span>
            <%= hidden_field_tag 'tag_cloud_order[]', cloud.id, class: 'tag-cloud-order-input', id: nil %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <% unless @tag_clouds.blank? %>
    <p class="tag-clouds-visibility-hint">
      <%= l(:text_select_visible_tag_clouds_hint) %>
    </p>
  <% end %>

  <div class="buttons tag-clouds-visibility-buttons">
    <%= submit_tag l(:button_save), name: nil, disabled: @tag_clouds.blank? %>
    <%= button_tag l(:button_cancel), type: 'button', onclick: 'hideModal(this);', name: nil %>
  </div>
<% end %>
