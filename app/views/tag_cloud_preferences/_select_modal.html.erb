<h3 class="title"><%= l(:label_select_visible_tag_clouds) %></h3>

<%= form_tag(project_tag_cloud_preferences_path(@project), method: :put, id: 'select-visible-tag-clouds-form') do %>
  <div class="box tag-clouds-visibility-box">
    <% all_visible = @system_visible && @tag_clouds.all? { |cloud| @visible_ids.include?(cloud.id) } %>
    <div class="tag-cloud-row tag-cloud-row-bulk">
      <label for="tag-clouds-check-all">
        <%= check_box_tag 'tag_clouds_check_all', '1', all_visible,
                          id: 'tag-clouds-check-all',
                          name: nil,
                          class: 'tag-clouds-check-all' %>
        <span class="tag-cloud-name"><%= l(:button_check_all) %> / <%= l(:button_uncheck_all) %></span>
      </label>
    </div>

    <div class="tag-clouds-visibility-scroll">
      <div class="tag-clouds-visibility-group tag-clouds-visibility-group-system">
        <ul class="tag-clouds-visibility-list tag-clouds-visibility-system" id="tag-clouds-system">
          <%= render partial: 'tag_cloud_preferences/system_visibility_row' %>
        </ul>
      </div>

      <% if @inherited_clouds.present? %>
        <div class="tag-clouds-visibility-group">
          <ul class="tag-clouds-visibility-list" id="tag-clouds-sortable-inherited">
            <% @inherited_clouds.each do |cloud| %>
              <%= render partial: 'tag_cloud_preferences/visibility_row',
                         locals: { cloud: cloud, inherited: true } %>
            <% end %>
          </ul>
        </div>
      <% end %>

      <% if @local_clouds.present? %>
        <div class="tag-clouds-visibility-group">
          <ul class="tag-clouds-visibility-list" id="tag-clouds-sortable">
            <% @local_clouds.each do |cloud| %>
              <%= render partial: 'tag_cloud_preferences/visibility_row',
                         locals: { cloud: cloud, inherited: false } %>
            <% end %>
          </ul>
        </div>
      <% end %>
    </div>
  </div>

  <div class="buttons tag-clouds-visibility-buttons">
    <span class="tag-clouds-visibility-buttons-left">
      <%= submit_tag l(:button_tag_cloud_preferences_reset),
                     name: 'reset_defaults',
                     id: 'tag-clouds-reset-defaults',
                     title: l(:text_tag_cloud_preferences_reset_title),
                     data: { disable_with: false } %>
    </span>
    <span class="tag-clouds-visibility-buttons-right">
      <%= submit_tag l(:button_save), name: nil %>
      <%= button_tag l(:button_cancel), type: 'button', onclick: 'hideModal(this);', name: nil %>
    </span>
  </div>
<% end %>
