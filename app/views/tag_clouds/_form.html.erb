<%
  status_selected  = Array(@tag_cloud.status_filter).map(&:to_i).reject(&:zero?)
  version_selected = Array(@tag_cloud.version_filter).map(&:to_i).reject(&:zero?)
  tracker_selected = Array(@tag_cloud.tracker_filter).map(&:to_i).reject(&:zero?)
  role_selected    = Array(@tag_cloud.role_ids).map(&:to_i).reject(&:zero?)
  tag_selected     = Array(@tag_cloud.tag_ids).map(&:to_i).reject(&:zero?)
  label_all = l(:label_all)
  visibility = @tag_cloud.visibility.presence || 'all'
  tag_filter_on = @tag_cloud.tag_filter
  filter_op = l(:label_tag_cloud_filter_is)
  preview_url = preview_project_tag_clouds_path(@project)
%>

<div class="box tag-cloud-form"
     data-label-all="<%= label_all %>"
     data-preview-url="<%= preview_url %>"
     data-label-empty="<%= l(:label_tag_cloud_empty) %>">
  <p class="tag-cloud-name-row">
    <%= f.label :name, l(:label_tag_cloud_name) %>
    <%= f.text_field :name, required: true, size: 60 %>
  </p>

  <fieldset class="tag-cloud-filters-fieldset">
    <legend><%= l(:label_tag_cloud_filters) %></legend>

    <div class="tag-cloud-filters-with-preview">
      <table class="tag-cloud-filters-table">
        <%# ---- Status ---- %>
        <tr class="tag-cloud-filter-row" data-filter="status_filter">
          <td class="tag-cloud-filter-field"><%= l(:field_status) %></td>
          <td class="tag-cloud-filter-op"><%= filter_op %></td>
          <td class="tag-cloud-filter-values">
            <span class="tag-cloud-filter-summary"<%= ' hidden' unless status_selected.empty? %>><%= label_all %></span>
            <select name="tag_cloud[status_filter][]" multiple="multiple"
                    size="<%= [[@statuses.size, 6].min, 3].max %>"
                    class="tag-cloud-filter-select"<%= ' hidden' if status_selected.empty? %>>
              <% @statuses.each do |s| %>
                <option value="<%= s.id %>"<%= ' selected' if status_selected.include?(s.id) %>><%= s.name %></option>
              <% end %>
            </select>
          </td>
          <td class="tag-cloud-filter-actions">
            <button type="button" class="tag-cloud-filter-toggle" data-open="<%= status_selected.any? ? '1' : '0' %>">
              <%= status_selected.empty? ? '+' : '−' %>
            </button>
          </td>
        </tr>

        <%# ---- Version ---- %>
        <tr class="tag-cloud-filter-row" data-filter="version_filter">
          <td class="tag-cloud-filter-field"><%= l(:field_fixed_version) %></td>
          <td class="tag-cloud-filter-op"><%= filter_op %></td>
          <td class="tag-cloud-filter-values">
            <span class="tag-cloud-filter-summary"<%= ' hidden' unless version_selected.empty? %>><%= label_all %></span>
            <select name="tag_cloud[version_filter][]" multiple="multiple"
                    size="<%= [[@versions.size, 6].min, 3].max %>"
                    class="tag-cloud-filter-select"<%= ' hidden' if version_selected.empty? %>>
              <% @versions.each do |v| %>
                <option value="<%= v.id %>"<%= ' selected' if version_selected.include?(v.id) %>><%= v.name %></option>
              <% end %>
            </select>
          </td>
          <td class="tag-cloud-filter-actions">
            <button type="button" class="tag-cloud-filter-toggle" data-open="<%= version_selected.any? ? '1' : '0' %>">
              <%= version_selected.empty? ? '+' : '−' %>
            </button>
          </td>
        </tr>

        <%# ---- Tracker ---- %>
        <tr class="tag-cloud-filter-row" data-filter="tracker_filter">
          <td class="tag-cloud-filter-field"><%= l(:field_tracker) %></td>
          <td class="tag-cloud-filter-op"><%= filter_op %></td>
          <td class="tag-cloud-filter-values">
            <span class="tag-cloud-filter-summary"<%= ' hidden' unless tracker_selected.empty? %>><%= label_all %></span>
            <select name="tag_cloud[tracker_filter][]" multiple="multiple"
                    size="<%= [[@trackers.size, 6].min, 3].max %>"
                    class="tag-cloud-filter-select"<%= ' hidden' if tracker_selected.empty? %>>
              <% @trackers.each do |t| %>
                <option value="<%= t.id %>"<%= ' selected' if tracker_selected.include?(t.id) %>><%= t.name %></option>
              <% end %>
            </select>
          </td>
          <td class="tag-cloud-filter-actions">
            <button type="button" class="tag-cloud-filter-toggle" data-open="<%= tracker_selected.any? ? '1' : '0' %>">
              <%= tracker_selected.empty? ? '+' : '−' %>
            </button>
          </td>
        </tr>
      </table>

      <div class="tag-cloud-preview-panel">
        <div class="tag-cloud-preview-title"><%= l(:label_tag_cloud_matching_tags) %></div>
        <div class="tag-cloud-preview-body" id="tag-cloud-preview-body">
          <p class="tag-cloud-empty"><%= l(:label_tag_cloud_empty) %></p>
        </div>
      </div>
    </div>
  </fieldset>

  <%# ---- Tag whitelist (tag_filter) ---- %>
  <fieldset class="tag-cloud-tag-filter-fieldset">
    <legend><%= l(:label_tag_cloud_tag_filter) %></legend>
    <p class="tag-cloud-tag-filter-toggle-row">
      <%= f.check_box :tag_filter, {}, '1', '0' %>
      <%= f.label :tag_filter, l(:label_tag_cloud_tag_filter_enable) %>
    </p>
    <p class="info tag-cloud-tag-filter-hint"><%= l(:text_tag_cloud_tag_filter_hint) %></p>

    <div id="tag-cloud-tags-panel"<%= ' hidden' unless tag_filter_on %>>
      <% if @available_tags.blank? %>
        <p class="info"><%= l(:text_tag_cloud_no_tags_in_project) %></p>
      <% else %>
        <table class="tag-cloud-filters-table">
          <tr class="tag-cloud-filter-row">
            <td class="tag-cloud-filter-field"><%= l(:tags) %></td>
            <td class="tag-cloud-filter-op"><%= filter_op %></td>
            <td class="tag-cloud-filter-values">
              <select name="tag_cloud[tag_ids][]" multiple="multiple"
                      size="<%= [[@available_tags.size, 8].min, 3].max %>"
                      class="tag-cloud-filter-select tag-cloud-tag-ids-select">
                <% @available_tags.each do |t| %>
                  <option value="<%= t.id %>"<%= ' selected' if tag_selected.include?(t.id) %>><%= t.name %></option>
                <% end %>
              </select>
            </td>
          </tr>
        </table>
      <% end %>
    </div>
  </fieldset>

  <%# ---- Visibility ---- %>
  <fieldset class="tag-cloud-visibility-fieldset">
    <legend><%= l(:label_tag_cloud_visibility_rule) %></legend>
    <p class="info"><%= l(:text_tag_cloud_visibility_hint) %></p>

    <div class="tag-cloud-visibility-options">
      <label class="tag-cloud-visibility-option">
        <%= f.radio_button :visibility, 'all' %>
        <span><%= l(:label_tag_cloud_visibility_all) %></span>
      </label>
      <label class="tag-cloud-visibility-option">
        <%= f.radio_button :visibility, 'owner' %>
        <span><%= l(:label_tag_cloud_visibility_owner) %></span>
      </label>
      <label class="tag-cloud-visibility-option">
        <%= f.radio_button :visibility, 'roles' %>
        <span><%= l(:label_tag_cloud_visibility_roles) %></span>
      </label>
    </div>

    <% if visibility == 'owner' && @tag_cloud.owner.present? %>
      <p class="tag-cloud-owner-info">
        <%= l(:label_tag_cloud_owner) %>: <%= h(@tag_cloud.owner.name) %>
      </p>
    <% end %>

    <div id="tag-cloud-roles-panel"<%= ' hidden' unless visibility == 'roles' %>>
      <table class="tag-cloud-filters-table">
        <tr class="tag-cloud-filter-row">
          <td class="tag-cloud-filter-field"><%= l(:label_role_plural) %></td>
          <td class="tag-cloud-filter-op"><%= filter_op %></td>
          <td class="tag-cloud-filter-values">
            <select name="tag_cloud[role_ids][]" multiple="multiple"
                    size="<%= [[(@roles || []).size, 6].min, 3].max %>"
                    class="tag-cloud-filter-select">
              <% (@roles || []).each do |r| %>
                <option value="<%= r.id %>"<%= ' selected' if role_selected.include?(r.id) %>><%= r.name %></option>
              <% end %>
            </select>
          </td>
        </tr>
      </table>
      <p class="info"><%= l(:text_tag_cloud_roles_required) %></p>
    </div>
  </fieldset>

  <p class="tag-cloud-visible-row">
    <%= f.check_box :visible_by_default, {}, '1', '0' %>
    <%= f.label :visible_by_default, l(:label_tag_cloud_visible_by_default) %>
  </p>
  <p class="info tag-cloud-visible-hint"><%= l(:text_tag_cloud_visible_by_default_hint) %></p>

  <p class="tag-cloud-subprojects-row">
    <%= f.check_box :include_subprojects, {}, '1', '0' %>
    <%= f.label :include_subprojects, l(:label_tag_cloud_include_subprojects) %>
  </p>
  <p class="info"><%= l(:text_tag_cloud_include_subprojects_hint) %></p>
</div>

<p class="buttons">
  <%= f.submit @tag_cloud.new_record? ? l(:button_create) : l(:button_save) %>
  <%= link_to l(:button_cancel), { controller: 'projects', action: 'settings', id: @project, tab: 'tags' } %>
</p>
