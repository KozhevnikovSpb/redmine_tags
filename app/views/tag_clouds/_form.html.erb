<%
  status_selected  = Array(@tag_cloud.status_filter).map(&:to_i).reject(&:zero?)
  version_selected = Array(@tag_cloud.version_filter).map(&:to_i).reject(&:zero?)
  tracker_selected = Array(@tag_cloud.tracker_filter).map(&:to_i).reject(&:zero?)
  role_selected    = Array(@tag_cloud.role_ids).map(&:to_i).reject(&:zero?)
  tag_selected     = Array(@tag_cloud.tag_ids).map(&:to_i).reject(&:zero?)
  label_all = l(:label_all)
  visibility = @tag_cloud.visibility.presence || 'all'
  tag_filter_on = @tag_cloud.tag_filter
  preview_url = preview_project_tag_clouds_path(@project)
  can_select_owner = @tag_cloud.can_set_owner_visibility?(User.current)
  visibility_author = @tag_cloud.visibility_author || User.current
  name_blank_message = l(:text_tag_cloud_name_blank)

  status_op  = @tag_cloud.respond_to?(:normalized_status_operator) ? @tag_cloud.normalized_status_operator : '*'
  version_op = @tag_cloud.respond_to?(:normalized_version_operator) ? @tag_cloud.normalized_version_operator : '*'
  tracker_op = @tag_cloud.respond_to?(:normalized_tracker_operator) ? @tag_cloud.normalized_tracker_operator : '*'
  status_values  = TagCloud::VALUE_OPERATORS.include?(status_op)
  version_values = TagCloud::VALUE_OPERATORS.include?(version_op)
  tracker_values = TagCloud::VALUE_OPERATORS.include?(tracker_op)
  status_multi  = status_selected.size > 1
  version_multi = version_selected.size > 1
  tracker_multi = tracker_selected.size > 1
%>

<div class="box tag-cloud-form"
     data-label-all="<%= label_all %>"
     data-preview-url="<%= preview_url %>"
     data-label-empty="<%= l(:label_tag_cloud_empty) %>">
  <p class="tag-cloud-name-row">
    <%= f.label :name, l(:label_tag_cloud_name) %>
    <%= f.text_field :name,
                     required: true,
                     size: 60,
                     maxlength: TagCloud::NAME_MAX_LENGTH,
                     class: 'tag-cloud-name-input',
                     data: { blank_message: name_blank_message },
                     oninvalid: "this.setCustomValidity(this.value ? '' : (this.getAttribute('data-blank-message') || ''))",
                     oninput: "this.setCustomValidity('')" %>
  </p>

  <fieldset class="tag-cloud-filters-fieldset">
    <legend><%= l(:label_tag_cloud_filters) %></legend>

    <div class="tag-cloud-filters-with-preview">
      <table class="tag-cloud-filters-table">
        <tr class="tag-cloud-filter-row" data-filter="status_filter" data-value-ops="=,!,ev,!ev,cf">
          <td class="tag-cloud-filter-field"><%= l(:field_status) %></td>
          <td class="tag-cloud-filter-op">
            <%= select_tag 'tag_cloud[status_operator]',
                           options_for_select(tag_cloud_status_operator_options, status_op),
                           class: 'tag-cloud-filter-operator' %>
          </td>
          <td class="tag-cloud-filter-values">
            <select name="tag_cloud[status_filter][]"
                    class="tag-cloud-filter-select"
                    <%= 'multiple="multiple"' if status_multi %>
                    size="<%= status_multi ? [[@statuses.size, 6].min, 3].max : 1 %>"
                    <%= 'hidden' unless status_values %>>
              <% @statuses.each do |s| %>
                <option value="<%= s.id %>"<%= ' selected' if status_selected.include?(s.id) %>><%= s.name %></option>
              <% end %>
            </select>
          </td>
          <td class="tag-cloud-filter-actions">
            <button type="button" class="tag-cloud-filter-toggle" data-open="<%= status_multi ? '1' : '0' %>"<%= ' hidden' unless status_values %>>
              <%= status_multi ? '−' : '+' %>
            </button>
          </td>
        </tr>

        <tr class="tag-cloud-filter-row" data-filter="version_filter" data-value-ops="=,!,ev,!ev,cf">
          <td class="tag-cloud-filter-field"><%= l(:field_fixed_version) %></td>
          <td class="tag-cloud-filter-op">
            <%= select_tag 'tag_cloud[version_operator]',
                           options_for_select(tag_cloud_version_operator_options, version_op),
                           class: 'tag-cloud-filter-operator' %>
          </td>
          <td class="tag-cloud-filter-values">
            <select name="tag_cloud[version_filter][]"
                    class="tag-cloud-filter-select"
                    <%= 'multiple="multiple"' if version_multi %>
                    size="<%= version_multi ? [[@versions.size, 6].min, 3].max : 1 %>"
                    <%= 'hidden' unless version_values %>>
              <% @versions.each do |v| %>
                <option value="<%= v.id %>"<%= ' selected' if version_selected.include?(v.id) %>><%= v.name %></option>
              <% end %>
            </select>
          </td>
          <td class="tag-cloud-filter-actions">
            <button type="button" class="tag-cloud-filter-toggle" data-open="<%= version_multi ? '1' : '0' %>"<%= ' hidden' unless version_values %>>
              <%= version_multi ? '−' : '+' %>
            </button>
          </td>
        </tr>

        <tr class="tag-cloud-filter-row" data-filter="tracker_filter" data-value-ops="=,!,ev,!ev,cf">
          <td class="tag-cloud-filter-field"><%= l(:field_tracker) %></td>
          <td class="tag-cloud-filter-op">
            <%= select_tag 'tag_cloud[tracker_operator]',
                           options_for_select(tag_cloud_tracker_operator_options, tracker_op),
                           class: 'tag-cloud-filter-operator' %>
          </td>
          <td class="tag-cloud-filter-values">
            <select name="tag_cloud[tracker_filter][]"
                    class="tag-cloud-filter-select"
                    <%= 'multiple="multiple"' if tracker_multi %>
                    size="<%= tracker_multi ? [[@trackers.size, 6].min, 3].max : 1 %>"
                    <%= 'hidden' unless tracker_values %>>
              <% @trackers.each do |t| %>
                <option value="<%= t.id %>"<%= ' selected' if tracker_selected.include?(t.id) %>><%= t.name %></option>
              <% end %>
            </select>
          </td>
          <td class="tag-cloud-filter-actions">
            <button type="button" class="tag-cloud-filter-toggle" data-open="<%= tracker_multi ? '1' : '0' %>"<%= ' hidden' unless tracker_values %>>
              <%= tracker_multi ? '−' : '+' %>
            </button>
          </td>
        </tr>
      </table>

      <div class="tag-cloud-preview-panel">
        <div class="tag-cloud-preview-title"><%= l(:label_tag_cloud_matching_tags) %></div>
        <div class="tag-cloud-preview-body" id="tag-cloud-preview-body">
          <p class="tag-cloud-empty"><%= l(:label_tag_cloud_empty) %></p>
        </div>
      </div>
    </div>
  </fieldset>

  <fieldset class="tag-cloud-tag-filter-fieldset">
    <legend><%= l(:label_tag_cloud_tag_filter) %></legend>
    <p class="tag-cloud-tag-filter-toggle-row">
      <%= f.check_box :tag_filter, {}, '1', '0' %>
      <%= f.label :tag_filter, l(:label_tag_cloud_tag_filter_enable) %>
    </p>
    <p class="info tag-cloud-tag-filter-hint"><%= l(:text_tag_cloud_tag_filter_hint) %></p>

    <div id="tag-cloud-tags-panel"<%= ' hidden' unless tag_filter_on %>>
      <% if @available_tags.blank? %>
        <p class="info"><%= l(:text_tag_cloud_no_tags_in_project) %></p>
      <% else %>
        <table class="tag-cloud-filters-table">
          <tr class="tag-cloud-filter-row">
            <td class="tag-cloud-filter-field"><%= l(:tags) %></td>
            <td class="tag-cloud-filter-values">
              <select name="tag_cloud[tag_ids][]" multiple="multiple"
                      size="<%= [[@available_tags.size, 8].min, 3].max %>"
                      class="tag-cloud-filter-select tag-cloud-tag-ids-select">
                <% @available_tags.each do |t| %>
                  <option value="<%= t.id %>"<%= ' selected' if tag_selected.include?(t.id) %>><%= t.name %></option>
                <% end %>
              </select>
            </td>
          </tr>
        </table>
      <% end %>
    </div>
  </fieldset>

  <fieldset class="tag-cloud-visibility-fieldset">
    <legend><%= l(:label_tag_cloud_visibility_rule) %></legend>
    <p class="info"><%= l(:text_tag_cloud_visibility_hint) %></p>

    <div class="tag-cloud-visibility-options">
      <label class="tag-cloud-visibility-option">
        <%= f.radio_button :visibility, 'all' %>
        <span><%= l(:label_tag_cloud_visibility_all) %></span>
      </label>
      <label class="tag-cloud-visibility-option<%= ' disabled' unless can_select_owner %>">
        <%= f.radio_button :visibility, 'owner', disabled: !can_select_owner %>
        <span><%= l(:label_tag_cloud_visibility_owner) %></span>
        <% if !can_select_owner && visibility == 'owner' %>
          <%= hidden_field_tag 'tag_cloud[visibility]', 'owner',
                               class: 'tag-cloud-visibility-owner-fallback',
                               id: nil %>
        <% end %>
      </label>
      <label class="tag-cloud-visibility-option">
        <%= f.radio_button :visibility, 'roles' %>
        <span><%= l(:label_tag_cloud_visibility_roles) %></span>
      </label>
    </div>

    <% unless can_select_owner %>
      <p class="info tag-cloud-owner-only-hint"><%= l(:text_tag_cloud_owner_only_author) %></p>
    <% end %>

    <p class="tag-cloud-owner-info"<%= ' hidden' unless visibility == 'owner' %>>
      <%= l(:label_tag_cloud_owner) %>: <%= visibility_author ? h(visibility_author.name) : '—' %>
    </p>

    <div id="tag-cloud-roles-panel"<%= ' hidden' unless visibility == 'roles' %>>
      <% if (@roles || []).blank? %>
        <p class="info"><%= l(:text_tag_cloud_no_roles) %></p>
      <% else %>
        <div class="tag-cloud-roles-list">
          <% @roles.each do |role| %>
            <label class="tag-cloud-role-option">
              <%= check_box_tag 'tag_cloud[role_ids][]', role.id, role_selected.include?(role.id), id: nil %>
              <span><%= role.name %></span>
            </label>
          <% end %>
        </div>
      <% end %>
      <p class="info"><%= l(:text_tag_cloud_roles_required) %></p>
    </div>
  </fieldset>

  <p class="tag-cloud-visible-row">
    <%= f.check_box :visible_by_default, {}, '1', '0' %>
    <%= f.label :visible_by_default, l(:label_tag_cloud_visible_by_default) %>
  </p>
  <p class="info tag-cloud-visible-hint"><%= l(:text_tag_cloud_visible_by_default_hint) %></p>

  <p class="tag-cloud-subprojects-row">
    <%= f.check_box :include_subprojects, {}, '1', '0' %>
    <%= f.label :include_subprojects, l(:label_tag_cloud_include_subprojects) %>
  </p>
  <p class="info"><%= l(:text_tag_cloud_include_subprojects_hint) %></p>
</div>

<p class="buttons">
  <%= f.submit @tag_cloud.new_record? ? l(:button_create) : l(:button_save) %>
  <%= link_to l(:button_cancel), { controller: 'projects', action: 'settings', id: @project, tab: 'tags' } %>
</p>
