<% tags = Issue.all_tags(all_issues: true, sort_by: 'name').to_a %>
<% color_by_id = {}
   ids = tags.map { |t| t.id.to_i }.uniq
   if ids.any?
     table = Redmineup::Tag.connection.quote_table_name(Redmineup::Tag.table_name)
     Redmineup::Tag.connection.select_rows("SELECT id, color FROM #{table} WHERE id IN (#{ids.join(',')})").each do |id, color|
       color_by_id[id.to_i] = color
     end
   end %>
<% unless tags.empty? %>
  <table class="list issues" id="manage-tags-table">
    <thead>
      <tr>
        <th class="checkbox hide-when-print">
          <%= link_to image_tag('toggle_check.png'), '#',
                                :onclick => "var $b=$('#manage-tags-table td.checkbox input[name=\\'ids[]\\']'); $b.prop('checked', $b.filter(':checked').length !== $b.length); return false;",
                                :title => "#{l(:button_check_all)}/#{l(:button_uncheck_all)}" %>
        </th>
        <th><%= l(:field_name) %></th>
        <th class="tag-manual-color" style="width:72px; text-align:center;"><%= l(:label_tag_color_manual) %></th>
        <th style="width:280px;"> </th>
      </tr>
    </thead>
    <tbody>
      <% tags.each do |tag| %>
        <% raw_color = color_by_id[tag.id.to_i]
           if raw_color.nil? && tag.respond_to?(:has_attribute?) && tag.has_attribute?(:color)
             raw_color = tag.read_attribute(:color)
           end %>
        <% manual = !raw_color.nil? && raw_color.to_s != '' %>
        <tr id="<%= tag.id %>" class="<%= cycle("odd", "even") %> hascontextmenu ">
          <td class="checkbox hide-when-print"><%= check_box_tag("ids[]", tag.id, false, :id => nil) %></td>
          <td><%= render_issue_tag_link(tag) %></td>
          <td class="tag-manual-color" style="text-align:center;">
            <input type="checkbox"
                   class="tag-manual-flag"
                   value="1"
                   tabindex="-1"
                   data-on="<%= manual ? '1' : '0' %>"
                   <%= 'checked="checked"' if manual %>>
          </td>
          <td class="buttons" style="white-space:nowrap;">
            <%= link_to sprite_icon('edit', l(:button_edit)), edit_tag_path(tag),
                                           :class => 'icon icon-edit' %>
            <span class="tag-reset-slot" style="display:inline-block; min-width:8.5em; vertical-align:middle;">
              <% if manual %>
                <%= link_to sprite_icon('reload', l(:button_tag_color_reset)), reset_color_tag_path(tag),
                                               :data => { :confirm => l(:text_tag_color_reset_confirm) },
                                               :class => 'icon icon-reload' %>
              <% else %>
                <%= content_tag(:span, sprite_icon('reload', l(:button_tag_color_reset)),
                                class: 'icon icon-reload disabled',
                                style: 'opacity:0.4; pointer-events:none; cursor:default; color:#999;') %>
              <% end %>
            </span>
            <%= link_to sprite_icon('del', l(:button_delete)), tags_path(:ids => tag),
                                           :method => :delete,
                                           :confirm => l(:text_are_you_sure),
                                           :class => 'icon icon-del' %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <% content_for :header_tags do
    javascript_include_tag('context_menu') + stylesheet_link_tag('context_menu')
  end %>

  <%= javascript_tag do %>
    $(document).ready(function(){
      $('#settings form').data('cmUrl', '<%= tags_context_menu_path %>');
      function restoreTagManualFlags() {
        $('#manage-tags-table input.tag-manual-flag').each(function () {
          this.checked = this.getAttribute('data-on') === '1';
        });
      }
      restoreTagManualFlags();
      $(document).on('click change contextmenu', '#manage-tags-table', function () {
        setTimeout(restoreTagManualFlags, 0);
      });
    });
  <% end %>
<% else %>
  <p class="nodata"><%= l(:label_no_data) %></p>
<% end %>
