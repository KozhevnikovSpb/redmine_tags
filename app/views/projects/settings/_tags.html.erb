<% can_manage = TagCloud.can_manage?(User.current, @project) %>
<% inherited_clouds = @project ? TagCloud.inherited_for(@project).select { |cloud| cloud.listed_in_settings_for?(User.current, project: @project) } : [] %>
<% if @project.present? %>
  <% @tag_clouds = TagCloud.for_project(@project).includes(:created_by).to_a.select { |cloud| cloud.listed_in_settings_for?(User.current, project: @project) } %>
<% end %>
<% system_visible_default = TagCloudProjectSetting.system_visible_by_default?(@project) %>
<% system_include_subprojects = !system_visible_default && TagCloudProjectSetting.local_include_subprojects?(@project) %>
<% system_locked = TagCloudProjectSetting.locked_by_ancestor?(@project) %>
<% reset_cycle('tag_cloud_rows') %>

<h3><%= l(:tag_clouds) %></h3>

<% if can_manage %>
  <p>
    <%= link_to sprite_icon('add', l(:label_new_tag_cloud)),
                new_project_tag_cloud_path(@project),
                class: 'icon icon-add' %>
  </p>
<% end %>

<style>
  .tag-clouds-settings-table > tbody > tr.even { background-color: #f6f7f8 !important; }
  .tag-clouds-settings-table > tbody > tr.odd { background-color: #fff !important; }
  .tag-clouds-settings-table .tag-cloud-col-visible,
  .tag-clouds-settings-table .tag-cloud-col-subprojects { text-align: center; }
  .tag-clouds-settings-table .tag-cloud-row-actions {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 2px;
  }
  .tag-clouds-settings-table .tag-cloud-action {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    min-height: 18px;
  }
  .tag-clouds-settings-table .tag-cloud-action-handle { min-width: 20px; }
</style>

<div class="tag-clouds-settings-wrap">
<table class="list tag-clouds-settings-table" id="tag-clouds-settings-table">
  <thead>
    <tr>
      <th class="tag-cloud-col-name"><%= l(:label_tag_cloud_name) %></th>
      <th class="tag-cloud-col-filters"><%= l(:label_tag_cloud_filters) %></th>
      <th class="tag-cloud-col-visibility"><%= l(:label_tag_cloud_visibility_rule) %></th>
      <th class="tag-cloud-col-author"><%= l(:field_author) %></th>
      <th class="tag-cloud-col-visible"><%= l(:label_tag_cloud_visible_by_default) %></th>
      <th class="tag-cloud-col-subprojects"><%= l(:label_tag_cloud_include_subprojects) %></th>
      <% if can_manage %>
        <th class="buttons"></th>
      <% end %>
    </tr>
  </thead>
  <tbody>
    <tr id="tag-cloud-system" class="<%= cycle('even', 'odd', name: 'tag_cloud_rows') %> system" data-id="system">
      <td class="tag-cloud-col-name name">
        <%= l(:label_default_tag_cloud) %>
        <%= tag_cloud_letter_marker(:system) %>
        <% if system_locked %>
          <%= tag_cloud_letter_marker(:inherited) %>
        <% end %>
      </td>
      <td class="tag-cloud-col-filters"><%= l(:label_all) %></td>
      <td class="tag-cloud-col-visibility"><%= l(:label_tag_cloud_visibility_all) %></td>
      <td class="tag-cloud-col-author">—</td>
      <td class="tag-cloud-col-visible">
        <input type="checkbox" class="tag-flag-checkbox" disabled="disabled" tabindex="-1" <%= 'checked="checked"' if system_visible_default %>>
      </td>
      <td class="tag-cloud-col-subprojects">
        <input type="checkbox" class="tag-flag-checkbox" disabled="disabled" tabindex="-1" <%= 'checked="checked"' if system_include_subprojects %>>
      </td>
      <% if can_manage %>
        <td class="buttons">
          <span class="tag-cloud-row-actions">
            <span class="tag-cloud-action tag-cloud-action-handle"></span>
            <span class="tag-cloud-action tag-cloud-action-edit">
              <% unless system_locked %>
                <%= link_to sprite_icon('edit', l(:button_edit)),
                            edit_system_project_tag_clouds_path(@project),
                            class: 'icon icon-edit' %>
              <% end %>
            </span>
            <span class="tag-cloud-action tag-cloud-action-delete"></span>
          </span>
        </td>
      <% end %>
    </tr>
  </tbody>

  <tbody id="tag-clouds-sortable-inherited"
         class="tag-clouds-sortable-settings"
         <% if can_manage && inherited_clouds.any? { |cloud| cloud.manageable_by?(User.current, project: @project) } %>
         data-reorder-url="<%= reorder_project_tag_clouds_path(@project) %>"
         data-inherited="1"
         <% end %>>
    <% inherited_clouds.each do |cloud| %>
      <% cloud_manageable = can_manage && cloud.manageable_by?(User.current, project: @project) %>
      <tr id="tag-cloud-inherited-<%= cloud.id %>"
          class="<%= cycle('even', 'odd', name: 'tag_cloud_rows') %> inherited"
          data-id="<%= cloud.id %>">
        <td class="tag-cloud-col-name name">
          <%= h(cloud.name) %>
          <%= tag_cloud_letter_marker(:inherited) %>
        </td>
        <td class="tag-cloud-col-filters"><%= tag_cloud_filters_summary(cloud) %></td>
        <td class="tag-cloud-col-visibility"><%= tag_cloud_visibility_summary(cloud) %></td>
        <td class="tag-cloud-col-author">
          <%= cloud.created_by ? link_to_user(cloud.created_by) : '—' %>
        </td>
        <td class="tag-cloud-col-visible">
          <input type="checkbox" class="tag-flag-checkbox" disabled="disabled" tabindex="-1" <%= 'checked="checked"' if cloud.visible_by_default %>>
        </td>
        <td class="tag-cloud-col-subprojects">
          <input type="checkbox" class="tag-flag-checkbox" disabled="disabled" tabindex="-1" <%= 'checked="checked"' if cloud.include_subprojects %>>
        </td>
        <% if can_manage %>
          <td class="buttons">
            <span class="tag-cloud-row-actions">
              <span class="tag-cloud-action tag-cloud-action-handle">
                <% if cloud_manageable %>
                  <span class="sort-handle tag-cloud-drag-handle">
                    <%= sprite_icon('reorder', '') %>
                  </span>
                <% end %>
              </span>
              <span class="tag-cloud-action tag-cloud-action-edit">
                <% if cloud_manageable %>
                  <%= link_to sprite_icon('edit', l(:button_edit)),
                              edit_project_tag_cloud_path(@project, cloud),
                              class: 'icon icon-edit' %>
                <% end %>
              </span>
              <span class="tag-cloud-action tag-cloud-action-delete">
                <% if cloud_manageable %>
                  <%= link_to sprite_icon('del', l(:button_delete)),
                              project_tag_cloud_path(@project, cloud),
                              method: :delete,
                              data: { confirm: l(:text_are_you_sure) },
                              class: 'icon icon-del' %>
                <% end %>
              </span>
            </span>
          </td>
        <% end %>
      </tr>
    <% end %>
  </tbody>

  <tbody id="tag-clouds-sortable-settings"
         class="tag-clouds-sortable-settings"
         <% if can_manage %>
         data-reorder-url="<%= reorder_project_tag_clouds_path(@project) %>"
         <% end %>>
    <% if @tag_clouds && @tag_clouds.any? %>
      <% @tag_clouds.each do |cloud| %>
        <% cloud_manageable = can_manage && cloud.manageable_by?(User.current, project: @project) %>
        <tr id="tag-cloud-<%= cloud.id %>"
            class="<%= cycle('even', 'odd', name: 'tag_cloud_rows') %> tag-cloud-local"
            data-id="<%= cloud.id %>">
          <td class="tag-cloud-col-name name"><%= h(cloud.name) %></td>
          <td class="tag-cloud-col-filters"><%= tag_cloud_filters_summary(cloud) %></td>
          <td class="tag-cloud-col-visibility"><%= tag_cloud_visibility_summary(cloud) %></td>
          <td class="tag-cloud-col-author">
            <%= cloud.created_by ? link_to_user(cloud.created_by) : '—' %>
          </td>
          <td class="tag-cloud-col-visible">
            <input type="checkbox" class="tag-flag-checkbox" disabled="disabled" tabindex="-1" <%= 'checked="checked"' if cloud.visible_by_default %>>
          </td>
          <td class="tag-cloud-col-subprojects">
            <input type="checkbox" class="tag-flag-checkbox" disabled="disabled" tabindex="-1" <%= 'checked="checked"' if cloud.include_subprojects %>>
          </td>
          <% if can_manage %>
            <td class="buttons">
              <span class="tag-cloud-row-actions">
                <span class="tag-cloud-action tag-cloud-action-handle">
                  <% if cloud_manageable %>
                    <span class="sort-handle tag-cloud-drag-handle">
                      <%= sprite_icon('reorder', '') %>
                    </span>
                  <% end %>
                </span>
                <span class="tag-cloud-action tag-cloud-action-edit">
                  <% if cloud_manageable %>
                    <%= link_to sprite_icon('edit', l(:button_edit)),
                                edit_project_tag_cloud_path(@project, cloud),
                                class: 'icon icon-edit' %>
                  <% end %>
                </span>
                <span class="tag-cloud-action tag-cloud-action-delete">
                  <% if cloud_manageable %>
                    <%= link_to sprite_icon('del', l(:button_delete)),
                                project_tag_cloud_path(@project, cloud),
                                method: :delete,
                                data: { confirm: l(:text_are_you_sure) },
                                class: 'icon icon-del' %>
                  <% end %>
                </span>
              </span>
            </td>
          <% end %>
        </tr>
      <% end %>
    <% end %>
  </tbody>
</table>
</div>
