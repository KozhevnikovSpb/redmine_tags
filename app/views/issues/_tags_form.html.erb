<% if User.current.allowed_to?(:edit_tags, @issue.project)  %>
  <p id="issue_tags">
    <label><%= l(:tags) %></label>
    <% tag_names = Redmineup::Tag.unscoped.order(Arel.sql("#{Redmineup::Tag.table_name}.name ASC")).pluck(:name) %>
    <%= select_tag 'issue[tag_list]',
                   options_for_select(tag_names, @issue.tag_list),
                   multiple: true,
                   id: 'issue_tag_list',
                   class: 'redmine-tags-local-select' %>
  </p>
<% end %>
