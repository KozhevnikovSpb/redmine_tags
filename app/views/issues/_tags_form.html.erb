<% if RedmineupTags.can_edit_issue_tags?(User.current, @issue.project) %>
  <p id="issue_tags">
    <label><%= l(:tags) %></label>
    <% tags_table = Redmineup::Tag.table_name %>
    <% taggings_table = Redmineup::Tagging.table_name %>
    <% tag_names = Redmineup::Tag.unscoped
         .joins("INNER JOIN #{taggings_table} ON #{taggings_table}.tag_id = #{tags_table}.id")
         .where("#{taggings_table}.taggable_type = ?", 'Issue')
         .distinct
         .order(Arel.sql("#{tags_table}.name ASC"))
         .pluck(:name) %>
    <%= select_tag 'issue[tag_list]',
                   options_for_select(tag_names, @issue.tag_list),
                   multiple: true,
                   id: 'issue_tag_list',
                   class: 'redmine-tags-local-select',
                   data: { allow_create: RedmineupTags.can_create_issue_tags?(User.current, @issue.project) ? '1' : '0' } %>
  </p>
<% end %>
