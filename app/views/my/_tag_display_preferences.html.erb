<% user = local_assigns[:user] || @user || User.current %>
<% TagCloudUserPreference.revoke_untagged_if_unauthorized!(user) %>
<% show_count = TagCloudUserPreference.show_count?(user) %>
<% can_untagged = TagCloudUserPreference.can_configure_untagged?(user) %>
<% show_untagged = can_untagged && TagCloudUserPreference.show_untagged?(user) %>
<fieldset id="tag-display-preferences" class="box tabular">
  <legend><%= l(:label_tag_display_preferences) %></legend>
  <p>
    <%= hidden_field_tag 'tag_display[show_count]', '0' %>
    <label for="tag_display_show_count"><%= l(:label_tag_display_show_count) %></label>
    <%= check_box_tag 'tag_display[show_count]', '1', show_count, id: 'tag_display_show_count' %>
  </p>
  <p class="tag-display-hint"><%= l(:text_tag_display_show_count_hint) %></p>
  <p class="tag-display-untagged-row<%= ' disabled' unless can_untagged %>">
    <%= hidden_field_tag 'tag_display[show_untagged]', '0' %>
    <label for="tag_display_show_untagged"><%= l(:label_tag_display_show_untagged) %></label>
    <%= check_box_tag 'tag_display[show_untagged]', '1', show_untagged,
                      id: 'tag_display_show_untagged',
                      disabled: !can_untagged %>
  </p>
  <p class="tag-display-hint"><%= l(:text_tag_display_show_untagged_hint) %></p>
</fieldset>
<%= javascript_tag nonce: true do %>
(function() {
  var box = document.getElementById('tag-display-preferences');
  if (!box) return;
  var form = document.getElementById('my_account_form');
  var left = form && form.querySelector('.splitcontentleft');
  if (!left) return;
  var save = left.querySelector('p.mobile-hide');
  if (save) {
    left.insertBefore(box, save);
  } else {
    left.appendChild(box);
  }
})();
<% end %>
