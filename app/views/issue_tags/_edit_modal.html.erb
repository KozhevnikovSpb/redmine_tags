<h3 class="title"><%= l(:label_tags_add_tags) %></h3>

<% if @is_bulk_editing %>
  <h3><%= l(:label_bulk_edit_selected_issues) %></h3>
  <ul>
    <% @issues.each do |issue| %>
      <%= content_tag 'li', link_to_issue(issue) %>
    <% end %>
  </ul>
<% else %>
  <h3><%= content_tag 'span', link_to_issue(@issues.first) %></h3>
<% end %>

<%= form_tag(update_issue_tags_path(ids: @issue_ids), method: :post, id: 'edit-issue-tags-form') do %>
  <%= hidden_field_tag :add_only, 1 %>
  <fieldset class="box">
    <legend><%= l(:tags) %></legend>
    <div id="issue_tags">
      <%= select2_tag 'issue[tag_list]',
                      [],
                      width: '100%',
                      multiple: true,
                      url: auto_complete_redmine_tags_path,
                      placeholder: @is_bulk_editing ? l(:label_no_change_option) : l(:label_tags_add_tag),
                      tags: RedmineupTags.can_create_issue_tags?(User.current, @projects) %>
    </div>

    <p class="most_used_tags">
      <%= safe_join(@most_used_tags.map { |tag| content_tag('span', tag.name, class: 'most_used_tag') }, ', ') %>
    </p>
    <%= javascript_tag "window.mostUsedTags = #{json_escape(@most_used_tags.map(&:name).to_json)};" %>
  </fieldset>

  <div class="buttons">
    <%= submit_tag l(:button_add), name: nil %>
    <%= submit_tag l(:button_cancel), name: nil, onclick: 'hideModal(this);', type: 'button' %>
  </div>
<% end %>
